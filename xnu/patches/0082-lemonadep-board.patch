diff --git a/pexpert/pexpert/arm64/LEMONADEP.h b/pexpert/pexpert/arm64/LEMONADEP.h
new file mode 100644
index 0000000..8275f1f
--- /dev/null
+++ b/pexpert/pexpert/arm64/LEMONADEP.h
@@ -0,0 +1,87 @@
+/*
+ * OnePlus 9 Pro ("lemonadep", Qualcomm SM8350 / Snapdragon 888). Shares the
+ * sweet code path: ARMv8.2 without PAC, 16K pages, GICv3 whose Group 0 is
+ * TrustZone's, so every interrupt arrives as a Group 1 IRQ.
+ *
+ * Board numbers measured from the live FDT/ABL handoff, not from a dts:
+ *   splash_region 0xE4D00000 (live con.fb), ABL draws 1080x2400 with a 4320-byte stride
+ *   virtual timer PPI 11 (DT <1 11 ...>) -> INTID 16 + 11 = 27
+ */
+#ifndef _PEXPERT_ARM64_LEMONADEP_H
+#define _PEXPERT_ARM64_LEMONADEP_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define LEMONADEP                 1
+
+/* Board numbers the shared code reads by name. */
+#define BOARD_FB_BASE             0xE4D00000
+#define BOARD_FB_END              10229760
+#define BOARD_FB_STRIDE           4320
+#define BOARD_NAME                "lemonadep"
+
+/*
+ * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
+ * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
+ * CPU_ON; the scheduler does not know the A76s are faster (no AMP/P-E
+ * clusters yet).
+ */
+#define SWEET_SMP_MAX_CPUS         8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * The DT lists the architected timer as <1 13>, <1 14>, <1 11>, <1 12>:
+ * the virtual timer XNU uses (CNTV) is PPI 11, i.e. INTID 16 + 11 = 27.
+ * (sweet's dtb numbered the same PPIs 3 and landed on 19 - do not copy it.)
+ */
+#define BOARD_VTIMER_INTID        27
+#define BOARD_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_LEMONADEP_H */
